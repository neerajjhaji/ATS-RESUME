# -----------------------------------------------------------------------------
# Resume Tailor — environment template
# Copy this file to `.env.local` and fill in your key. `.env.local` is gitignored.
# -----------------------------------------------------------------------------

# Your Google Gemini API key. Obtain one from https://aistudio.google.com/apikey
# This is read ONLY on the server (process.env.GEMINI_API_KEY) and is never
# exposed to the browser. Do not prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Adzuna job-search API (optional) — powers the Agent Hub live job feed.
# Free key: https://developer.adzuna.com  (create an app to get an ID + key)
# Server-only, like the Gemini key. NEVER put site passwords here.
# -----------------------------------------------------------------------------
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
